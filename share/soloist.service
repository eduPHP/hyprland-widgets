[Unit]
Description=Spotify Soloist (player do hyprspot)
Wants=network-online.target
After=network-online.target pipewire-pulse.service
# sem chave não adianta subir (a tela "hyprspot setup" grava a chave e inicia o serviço)
ConditionPathExists=%h/.config/hyprspot/soloist.env

[Service]
EnvironmentFile=%h/.config/hyprspot/soloist.env
ExecStart=%h/.local/bin/soloist --device-name hyprspot --api-key ${SOLOIST_API_KEY} --ws 127.0.0.1:9090 --initial-volume 60
Restart=on-failure
RestartSec=5
# código 10 = build expirado (90 dias); não adianta reiniciar
RestartPreventExitStatus=10

[Install]
WantedBy=default.target
