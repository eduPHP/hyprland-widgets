#!/usr/bin/env python3
"""hyprpower: power + display popover for Hyprland (hypr-ui look). Kept free of GTK imports so binds stay fast.

  hyprpower                  toggle the popover on the power tab (starts the daemon on first run)
  hyprpower display          toggle it on the display tab (or switch tabs when open)
  hyprpower open [tab]       open if closed
  hyprpower close            close if open (never starts the daemon)
  hyprpower profile [next|power-saver|balanced|performance]
                             print or set the power profile
  hyprpower quit             stop the daemon
  hyprpower --daemon         run the resident GTK process (Hyprland exec-once)
"""

import os
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(HERE))
import backend as be  # noqa: E402  (no GTK in here)

SOCK = be.RUN / "hyprpower.sock"
LAYER_SHELL = "/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0"


def send(cmd: str) -> bool:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(str(SOCK))
        s.sendall(cmd.encode())
        return True
    except OSError:
        return False
    finally:
        s.close()


def start_daemon():
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "--daemon"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def daemon():
    # gtk4-layer-shell must be loaded before libwayland-client
    if LAYER_SHELL not in os.environ.get("LD_PRELOAD", ""):
        os.environ["LD_PRELOAD"] = ":".join(filter(None, [LAYER_SHELL, os.environ.get("LD_PRELOAD")]))
        os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), *sys.argv[1:]])
    if send("ping"):
        sys.exit("hyprpower daemon already running")
    import widget

    widget.main(SOCK)


def main():
    args = sys.argv[1:]
    if args[:1] == ["--daemon"]:
        return daemon()
    if args in (["-h"], ["--help"], ["help"]):
        return print(__doc__)
    if args[:1] == ["profile"]:
        cur = be.profile()
        if len(args) == 1:
            return print(cur)
        want = args[1]
        if want == "next":
            want = be.PROFILES[(be.PROFILES.index(cur) + 1) % len(be.PROFILES)] if cur in be.PROFILES else "balanced"
        if want not in be.PROFILES:
            sys.exit(f"unknown profile {want!r}; one of {', '.join(be.PROFILES)}")
        subprocess.run(["powerprofilesctl", "set", want])
        return print(want)

    cmd = args or ["toggle"]
    if cmd[0] in ("power", "display"):
        cmd = ["toggle", cmd[0]]
    if cmd[0] not in ("toggle", "open", "close", "quit"):
        sys.exit(__doc__)
    line = " ".join(cmd)
    if send(line) or cmd[0] in ("close", "quit"):
        return
    start_daemon()
    for _ in range(60):
        time.sleep(0.1)
        if send(line):
            return
    sys.exit("hyprpower daemon did not start")


if __name__ == "__main__":
    main()
