#!/usr/bin/env bash
# Wrapper: a libgtk4-layer-shell precisa ser carregada antes da libwayland-client.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LS=""
for d in /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/lib64 /usr/lib /usr/local/lib64 /usr/local/lib; do
  if [ -e "$d/libgtk4-layer-shell.so.0" ]; then LS="$d/libgtk4-layer-shell.so.0"; break; fi
done
[ -n "$LS" ] || LS="$(ldconfig -p 2>/dev/null | awk '/libgtk4-layer-shell\.so\.0 /{print $NF; exit}')"
if [ -n "$LS" ]; then export LD_PRELOAD="$LS${LD_PRELOAD:+:$LD_PRELOAD}"; fi
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m hyprspot "$@"
