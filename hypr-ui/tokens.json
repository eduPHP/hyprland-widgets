{
  "$comment": "hypr-ui design tokens: the single source for every desktop widget. Edit here, then run ./build.py.",
  "color": {
    "bg": "#16161e",
    "surface": "#1f2335",
    "raised": "#24283b",
    "line": "#292e42",
    "frame": "#3f537d",
    "track": "#2f3449",
    "fg": "#c0caf5",
    "bright": "#e6e8ef",
    "muted": "#737aa2",
    "faint": "#565f89",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "purple": "#bb9af7",
    "green": "#9ece6a",
    "amber": "#e0af68",
    "orange": "#ff9e64",
    "red": "#f7768e",
    "ink": "#16161e"
  },
  "font": {
    "family": "JetBrainsMono Nerd Font",
    "fallback": "\"JetBrains Mono\", monospace"
  },
  "size": {
    "micro": 9,
    "small": 10,
    "caption": 11,
    "body": 12,
    "title": 13,
    "icon": 15,
    "big": 18,
    "hero": 22
  },
  "radius": {
    "surface": 12,
    "card": 10,
    "control": 7,
    "chip": 4,
    "toast": 16,
    "pill": 999
  },
  "space": {
    "pad": 12,
    "gap": 10,
    "rowY": 7,
    "rowX": 8
  },
  "control": {
    "height": 30,
    "tile": 30
  },
  "shadow": {
    "y": 4,
    "blur": 12,
    "alpha": 0.38
  },
  "surface": {
    "$comment": "Popovers sit gapTop px under the bar and gapRight px from the screen edge. The window is `margin` px larger on every side so the shadow is never clipped; that margin is click-through.",
    "margin": 16,
    "gapTop": 6,
    "gapRight": 8
  }
}
