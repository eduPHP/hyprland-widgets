/* hypr-ui base stylesheet for GTK4 widgets.
 * GENERATED by build.py from gtk/hypr-ui.css.in + tokens.json. Edit those, not this file.
 * Loaded before each widget's own style.css (see gtk/hypr_ui.py), so a widget only
 * adds what is specific to it and may override anything here. */

{{colors}}

window { background: transparent; }
/* Hyprland skips input on fully transparent pixels, so the click-outside layer needs a hint of alpha */
window.backdrop { background: rgba(0, 0, 0, 0.01); }

* {
  font-family: "{{font.family}}", {{font.fallback}};
  font-size: {{size.body}}px;
  color: @fg;
}

/* ---- surfaces ------------------------------------------------------------
 * The border is an opaque colour on purpose: at fractional scales (1.2 here)
 * a translucent 1px line lands on two device pixels and every side ends up a
 * different brightness. The margin leaves room for the shadow inside the
 * layer surface (hypr_ui.popover() makes that margin click-through). */
.popover, .toast {
  background: @bg;
  border: 1px solid @frame;
  margin: {{surface.margin}}px;
  box-shadow: 0 {{shadow.y}}px {{shadow.blur}}px alpha(black, {{shadow.alpha}});
}
.popover { border-radius: {{radius.surface}}px; padding: {{space.pad}}px; }
.toast { border-radius: {{radius.toast}}px; padding: {{space.pad}}px 16px; }

/* ---- header: [app-icon] title / subtitle ............ actions ------------ */
.app-icon {
  background: @raised;
  border-radius: 8px;
  min-width: {{control.tile}}px;
  min-height: {{control.tile}}px;
  color: @blue;
  font-size: {{size.icon}}px;
}
.title { font-weight: bold; font-size: {{size.title}}px; }
.subtitle { color: @muted; font-size: {{size.small}}px; }

/* ---- buttons ---------------------------------------------------------------- */
button.icon {
  background: none;
  border: none;
  box-shadow: none;
  padding: 2px 6px;
  min-height: 0;
  color: @muted;
  font-size: {{size.icon}}px;
}
button.icon:hover { color: @fg; }

button.ghost {
  background: none;
  border: 1px solid @line;
  border-radius: 6px;
  padding: 3px 10px;
  min-height: 0;
  box-shadow: none;
  font-size: {{size.caption}}px;
}
button.ghost:hover { background: @raised; border-color: @faint; }

button.primary {
  background: @blue;
  border: none;
  border-radius: 6px;
  box-shadow: none;
  padding: 4px 12px;
  min-height: 0;
  font-size: {{size.caption}}px;
}
button.primary label { color: @ink; font-weight: bold; }
button.primary:hover { background: shade(@blue, 1.08); }
button.primary:disabled { background: alpha(@blue, 0.35); }

button.link {
  background: none;
  border: none;
  box-shadow: none;
  color: @muted;
  font-size: {{size.caption}}px;
  padding: 4px 8px;
}
button.link label { text-decoration: none; }
button.link:hover { color: @fg; }

/* keyboard-focus rings stay as quiet as the borders */
button:focus-visible, switch:focus-visible { outline: 1px solid alpha(@fg, 0.15); outline-offset: 1px; }

/* ---- switch ------------------------------------------------------------------ */
switch {
  background: @line;
  border: none;
  border-radius: {{radius.pill}}px;
  min-width: 38px;
  min-height: 20px;
  transition: background 150ms ease;
}
switch:checked { background: @blue; }
switch slider {
  background: @bg;
  border: none;
  border-radius: {{radius.pill}}px;
  min-width: 16px;
  min-height: 16px;
  margin: 2px;
  box-shadow: none;
}
switch:not(:checked) slider { background: @muted; }

/* ---- cards, tabs ----------------------------------------------------------- */
.card {
  background: @surface;
  border: 1px solid @line;
  border-radius: {{radius.card}}px;
  padding: 10px {{space.pad}}px;
}

.tabs {
  background: @surface;
  border: 1px solid @line;
  border-radius: 9px;
  padding: 3px;
}
button.tab {
  background: none;
  border: none;
  box-shadow: none;
  border-radius: 6px;
  padding: 4px 0;
  min-height: 0;
}
button.tab:hover { background: alpha(@raised, 0.6); }
button.tab.active { background: @raised; }

/* ---- lists ------------------------------------------------------------------- */
.section { color: @faint; font-size: {{size.small}}px; letter-spacing: 1px; }
.section-meta { color: @faint; font-size: {{size.small}}px; }

.row {
  border: 1px solid transparent;
  border-radius: {{radius.control}}px;
  padding: {{space.rowY}}px {{space.rowX}}px;
  transition: background 120ms ease;
}
.row:hover { background: alpha(@raised, 0.6); }
.row.selected { background: @raised; }

.badge {
  background: @line;
  border-radius: {{radius.chip}}px;
  padding: 1px 6px;
  color: @muted;
  font-size: {{size.micro}}px;
  min-width: 18px;
}

/* ---- inputs ------------------------------------------------------------------ */
entry {
  background: @bg;
  border: 1px solid @line;
  border-radius: {{radius.control}}px;
  padding: 6px 10px;
  min-height: 0;
  box-shadow: none;
  caret-color: @blue;
}
entry:focus-within { border-color: @blue; outline: none; }
entry text placeholder { color: @faint; }

spinner { color: @blue; min-width: 11px; min-height: 11px; }

/* ---- footer: key hints ------------------------------------------------------- */
.footer { padding-top: 6px; border-top: 1px solid @line; }
.key {
  background: @line;
  border-radius: {{radius.chip}}px;
  padding: 0 4px;
  color: @fg;
  font-size: {{size.micro}}px;
}
.hint { color: @faint; font-size: {{size.micro}}px; }
