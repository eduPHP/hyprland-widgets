# {{ theme_title }}: lock screen colours, sourced from ~/.config/hypr/hyprlock.conf.
$lock_background = rgba({{ background_strip }}ff)
$lock_inner = rgba({{ background_strip }}cc)
$lock_outer = rgba({{ accent_strip }}ff)
$lock_text = rgba({{ bright_foreground_strip }}ff)
$lock_check = rgba({{ green_strip }}ff)
$lock_fail = rgba({{ red_strip }}ff)
