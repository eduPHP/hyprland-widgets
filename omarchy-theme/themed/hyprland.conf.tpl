# {{ theme_title }}: window borders. Sourced from ~/.config/hypr/hyprland.conf.
general {
    col.active_border = {{ hyprland_active_border_hypr }}
    col.inactive_border = {{ hyprland_inactive_border_hypr }}
}
group {
    col.border_active = {{ hyprland_active_border_hypr }}
    col.border_inactive = {{ hyprland_inactive_border_hypr }}
}
