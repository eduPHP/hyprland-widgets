/* {{ theme_title }}: waybar colours, imported by ~/.config/waybar/style.css. */
@define-color background {{ background }};
@define-color foreground {{ bright_foreground }};
@define-color accent {{ accent }};
@define-color red {{ red }};
@define-color yellow {{ yellow }};
@define-color orange {{ orange }};
@define-color muted {{ mix dark_foreground bright_foreground 35% }};
@define-color faint {{ dark_foreground }};
